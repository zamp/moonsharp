<Project Sdk="Microsoft.NET.Sdk">
	<!-- Fork of MoonSharp 2.0.0 (BSD 3-clause, see ../LICENSE), built for .NET 8 with the defines of the upstream netstandard1.6 package -->
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Deterministic>true</Deterministic>
		<AssemblyName>MoonSharp.Interpreter</AssemblyName>
		<RootNamespace>MoonSharp.Interpreter</RootNamespace>
		<DefineConstants>$(DefineConstants);DOTNET_CORE;NETFX_CORE</DefineConstants>
		<Nullable>disable</Nullable>
		<LangVersion>7.3</LangVersion>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
		<WarningLevel>0</WarningLevel>
		<NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS1591;CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1658;SYSLIB0050;SYSLIB0051</NoWarn>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../src/MoonSharp.Interpreter/**/*.cs" Exclude="../src/MoonSharp.Interpreter/_Projects/**" />
	</ItemGroup>
</Project>
